{
  "name": "solana-wallet-snap-monorepo",
  "version": "3.0.0",
  "private": true,
  "description": "",
  "homepage": "https://github.com/MetaMask/snap-solana-wallet#readme",
  "bugs": {
    "url": "https://github.com/MetaMask/snap-solana-wallet/issues"
  },
  "license": "(MIT-0 OR Apache-2.0)",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaMask/snap-solana-wallet.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --parallel --topological --verbose run build",
    "lint": "yarn lint:eslint && yarn lint:misc --check",
    "lint:eslint": "eslint . --cache",
    "lint:fix": "yarn lint:eslint --fix && yarn lint:misc",
    "lint:misc": "oxfmt --ignore-path .gitignore",
    "prepare": "husky",
    "start": "yarn workspaces foreach --parallel --interlaced --verbose run start",
    "test": "yarn workspace @metamask/solana-wallet-snap run test --detectOpenHandles",
    "test:watch": "yarn workspace @metamask/solana-wallet-snap run test:watch"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "@lavamoat/allow-scripts": "^3.3.0",
    "@lavamoat/preinstall-always-fail": "^2.1.0",
    "@metamask/eslint-config": "^15.0.0",
    "@metamask/eslint-config-browser": "^15.0.0",
    "@metamask/eslint-config-jest": "^15.0.0",
    "@metamask/eslint-config-nodejs": "^15.0.0",
    "@metamask/eslint-config-typescript": "^15.0.0",
    "@metamask/utils": "^11.9.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "babel-plugin-styled-components": "^2.1.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import-x": "^4.3.0",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-jsdoc": "^50.2.4",
    "eslint-plugin-n": "^17.10.3",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.1.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "oxfmt": "^0.45.0",
    "prettier": "^3.5.3",
    "prettier-plugin-packagejson": "^2.2.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.48.0"
  },
  "resolutions": {
    "@metamask/snaps-execution-environments": "11.2.0",
    "@metamask/snaps-sdk": "^11.1.1",
    "@types/react": "18.2.4",
    "@types/react-dom": "18.2.4"
  },
  "lint-staged": {
    "*": [
      "yarn lint:fix"
    ]
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "packageManager": "yarn@4.17.1",
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false,
      "sharp": true,
      "@commitlint/cli>@commitlint/load>ts-node>@swc/core": false,
      "eslint-plugin-import-x>unrs-resolver": false,
      "jest>@jest/core>jest-resolve>unrs-resolver": false
    }
  }
}
